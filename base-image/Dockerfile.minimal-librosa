# FAVE Minimal Librosa Base Image
# For stage-librosa audio segmentation
# Size: ~1.2 GB (down from 2.2 GB)

FROM python:3.9-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Librosa system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Librosa Python dependencies (includes numpy, scipy)
COPY requirements-minimal-librosa.txt /tmp/requirements.txt
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r /tmp/requirements.txt

# Common utilities
COPY common/ /opt/fave_common/
ENV PYTHONPATH="/opt/fave_common:${PYTHONPATH}"

WORKDIR /workspace
